# Copy to .env for local development. On SiteGround, set these as environment
# variables in Site Tools instead (the .env file is not committed).

# Port the Node app listens on. SiteGround provides PORT automatically.
PORT=3000

# Public URL of this site (no trailing slash). Used for canonical URLs, sitemap, and schema.
SITE_URL=https://thehardygroup.org

# Headless WordPress install (no trailing slash).
WP_URL=https://cms.thehardygroup.org

# How long (seconds) CMS responses are cached in memory before re-fetching.
CMS_CACHE_TTL=300

# Shared secret WordPress sends to /api/revalidate when a post is published or
# updated, so changes show up immediately instead of waiting for the cache TTL.
# Use a long random string and put the same value in wp-config.php (see wordpress/README.md).
REVALIDATE_SECRET=change-me
