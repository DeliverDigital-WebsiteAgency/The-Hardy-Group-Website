{% extends "layout.njk" %}
{% from "blog/_macros.njk" import byline, postList %}
{% set nav = "blog" %}
{% set title = post.title %}
{% set seoTitle = post.seoTitle %}
{% set description = post.description %}
{% set ogType = "article" %}

{% block head %}
<meta property="article:published_time" content="{{ post.date }}">
<meta property="article:modified_time" content="{{ post.modified }}">
{% for a in post.authors %}<meta property="article:author" content="{{ site.url }}/blog/author/{{ a.slug }}">
{% endfor %}
{% endblock %}

{% block content %}
<section class="page-header">
  <div class="page-header-inner">
    <a class="breadcrumb" href="/blog">&larr; All Articles</a>
    <p class="eyebrow">Ministry Blogs</p>
    <h1>{{ post.title }}</h1>
    <div class="divider"></div>
    {{ byline(post) }}
  </div>
</section>

{% if post.image %}
<div class="post-hero-image">
  <img src="{{ post.image.url }}" alt="{{ post.image.alt }}" fetchpriority="high">
</div>
{% endif %}

<article class="page-body">
  <div class="page-body-inner">
    <div class="prose">
      {{ post.content | safe }}
    </div>

    <section class="author-boxes" aria-label="About the {{ 'authors' if post.authors.length > 1 else 'author' }}">
      {% for author in post.authors %}
      <aside class="author-box">
        {% if author.photo %}<img src="{{ author.photo }}" alt="{{ author.name }}" width="72" height="72" loading="lazy">{% endif %}
        <div>
          <p class="eyebrow">About the Author</p>
          <h2><a href="/blog/author/{{ author.slug }}">{{ author.name }}</a></h2>
          {% if author.bio %}<p>{{ author.bio }}</p>{% endif %}
        </div>
      </aside>
      {% endfor %}
    </section>

    {{ postList(relatedPosts, "More articles for pastors", "h2") }}

    <p class="post-disclaimer">This article is for general informational purposes only and is not legal, tax, financial, or other professional advice. See our <a href="/terms">Terms and Conditions</a>.</p>
  </div>
</article>

<section class="page-cta">
  <p>Want a seasoned guide for the decisions in front of your church? Learn about <a href="/personal-coaching">Lead Pastor Coaching</a> with Dick Hardy, or send us a leadership question you'd like us to write about.</p>
  <a class="btn-gold" href="mailto:{{ site.email }}">Contact Us</a>
</section>
{% endblock %}
